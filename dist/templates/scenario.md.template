scenario_id: <UUID-suffix-or-short-hash>
parent_spec: <path-to-spec-artifact>
status: draft
language: <python|typescript>
generator: <pytest|jest>
authored_by: <qa-author-name-or-handle>
authored_at: <ISO-date>
last_synced_to_spec_at: <ISO-date>

# Action under test — structured for the generator
action:
  type: http              # http | function | event | command
  method: POST            # HTTP method (for type: http)
  endpoint: /subscribe    # endpoint path or function name
  # for type: function:
  #   module: myapp.subscriptions
  #   function: create_subscription
  # for type: event:
  #   topic: subscriptions.requested
  # for type: command:
  #   command: ./scripts/run-batch.sh

# Setup preconditions — fixture-style. The generator translates these to
# pytest fixtures / Jest beforeEach blocks. Use free-form strings; the
# generator does NOT execute these — it generates a stub the human wires up.
setup:
  - customer exists with id "cust-123" and no active subscription
  - advisor "adv-77" is available for tier "gold"

# Expected observable outcomes — each becomes one assertion in the generated test
expectations:
  - http_status: 201
  - response_body_contains:
      subscription_id: "<uuid>"
      tier: gold
      status: active
  - side_effect: "subscription.created event published with payload matching response"
  - db_row_exists: "subscriptions table contains row with customer_id=cust-123 and tier=gold"

# OPTIONAL: UI flow for end-to-end Playwright test generation.
# Only include this block if the scenario is user-facing (full-stack or frontend-only spec).
# When present, the scenario generator emits BOTH an integration test AND a Playwright e2e test.
# When absent, only the integration test is generated.
#
# Selector prefix vocabulary (favor semantic locators over CSS):
#   text:<text>        → page.getByText('<text>')
#   button:<name>      → page.getByRole('button', { name: '<name>' })
#   link:<name>        → page.getByRole('link', { name: '<name>' })
#   label:<text>       → page.getByLabel('<text>')
#   testid:<id>        → page.getByTestId('<id>')
#   placeholder:<text> → page.getByPlaceholder('<text>')
#   anything else      → page.locator('<raw-css>')
#
# Step vocabulary:
#   navigate: <url>              → page.goto(url)
#   click: <selector>            → click element
#   fill: <selector>, value: <v> → type text into input
#   select: <selector>, value: <v> → select dropdown option
#   wait_for: <selector>         → wait for element to appear
#
# Expectation vocabulary:
#   url_matches: <pattern>       → expect(page).toHaveURL(...)
#   visible: <selector>          → toBeVisible
#   not_visible: <selector>      → not.toBeVisible
#   text_contains: <text>        → page contains text
ui_action:
  start_url: "/signup"
  steps:
    - select: "label:Tier"
      value: "gold"
    - fill: "label:Advisor ID"
      value: "adv-77"
    - click: "button:Subscribe"
  expect:
    - url_matches: "/subscribe/success"
    - visible: "text:Welcome to gold tier"
