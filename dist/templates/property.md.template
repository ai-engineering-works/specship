---
property_id: <UUID-suffix-or-short-hash>
parent_spec: <path-to-spec-artifact>
status: draft
language: <python|typescript>
generator: <hypothesis|fast-check>
authored_by: <qa-author-name-or-handle>
authored_at: <ISO-date>
last_synced_to_spec_at: <ISO-date>
max_examples: 100         # how many input cases the framework should generate

# Action under test — same structure as scenarios
action:
  type: http              # http | function | event
  method: POST
  endpoint: /subscribe
  # for type: function:
  #   module: myapp.subscriptions
  #   function: create_subscription

# Input generators — declarative DSL, one entry per input field.
# The generator translates each form to hypothesis / fast-check code.
#
# Supported forms (v1):
#   int(min: M, max: N)
#   float(min: M, max: N)
#   string(min_len: M, max_len: N)
#   enum[a, b, c]
#   bool
#   date(min: YYYY-MM-DD, max: YYYY-MM-DD)
#   list(of: <subgen>, min_len: M, max_len: N)
#   optional(<subgen>)
#   dict(key1: <subgen>, key2: <subgen>, ...)
#
# Examples:
#   customer_id: string(min_len: 1, max_len: 50)
#   tier: enum[bronze, silver, gold]
#   amount: int(min: 1, max: 1000000)
#   start_date: date(min: 2020-01-01, max: 2030-12-31)
#   tags: list(of: string(min_len: 1, max_len: 20), min_len: 0, max_len: 10)
#   advisor_id: optional(string(min_len: 1, max_len: 50))
generators:
  customer_id: string(min_len: 1, max_len: 50)
  tier: enum[bronze, silver, gold]
  advisor_id: string(min_len: 1, max_len: 50)

# The invariant, expressed as both prose and executable expression.
invariant:
  prose: "<one-sentence human description of the invariant>"
  # The assert expression should be a Python expression (the generator
  # translates to TypeScript when generator=fast-check). It can reference:
  #   - the input variables (one per key in `generators:`)
  #   - `actual` — the value returned by the action
  #   - `actual_status` — HTTP status if action.type == http
  #   - `actual_body` — response body if action.type == http
  expression: "actual_body['tier'] in ('bronze', 'silver', 'gold')"

# Optional: filter out inputs that shouldn't be tested (e.g., known invalid
# combinations the system rejects with 400). The framework will silently
# discard inputs failing this filter.
input_filter: ""    # leave empty for no filter
---

